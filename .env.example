# Neon (https://neon.tech) — get both from the project's Connect dialog.

# Pooled connection (hostname has "-pooler") — used by Prisma Client at
# runtime via @prisma/adapter-neon (see src/lib/prisma.ts).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/fi_sync?sslmode=require"

# Direct (non-pooled) connection — used by the Prisma CLI for migrations,
# introspection, Prisma Studio (see prisma.config.ts).
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/fi_sync?sslmode=require"

# Neon Auth ("Managed Better Auth") — Project → Branch → Auth → Configuration.
# Server-side (Server Components, Server Actions, Route Handlers, proxy.ts).
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/fi_sync/auth"
# Same Auth URL, exposed to the client — required by createAuthClient() in
# src/lib/auth/client.ts (Next.js only reads env vars prefixed NEXT_PUBLIC_
# in the browser bundle).
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/fi_sync/auth"
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="your-secret-at-least-32-characters-long"
