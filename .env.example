# Neon (https://neon.tech) — get both from the project's Connect dialog.

# Pooled connection (hostname has "-pooler") — used by Prisma Client at
# runtime via @prisma/adapter-neon (see src/lib/prisma.ts).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/fi_sync?sslmode=require"

# Direct (non-pooled) connection — used by the Prisma CLI for migrations,
# introspection, Prisma Studio (see prisma.config.ts).
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/fi_sync?sslmode=require"

# Neon Auth ("Managed Better Auth") — Project → Branch → Auth → Configuration.
# Server-side (Server Components, Server Actions, Route Handlers, proxy.ts).
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/fi_sync/auth"
# Same Auth URL, exposed to the client — required by createAuthClient() in
# src/lib/auth/client.ts (Next.js only reads env vars prefixed NEXT_PUBLIC_
# in the browser bundle).
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/fi_sync/auth"
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="your-secret-at-least-32-characters-long"

# Groq (https://console.groq.com) — inferência do bot de Telegram
# (tasks/018). Chave direta do provedor, sem passar pelo Vercel AI
# Gateway. Ligue Zero Data Retention em Data Controls no console —
# é grátis em todos os planos e impede a retenção de 30 dias.
GROQ_API_KEY="gsk_..."
# Id do modelo na Groq (confira o catálogo da sua conta em
# /openai/v1/models). Padrão do código se não definido:
# openai/gpt-oss-120b
AI_MODEL="openai/gpt-oss-120b"
# Modelo de VISÃO na Groq — usado só pela importação de fatura/extrato
# quando o arquivo é uma foto/print (o AI_MODEL acima não lê imagem).
# PDF não passa por aqui: o texto é extraído com unpdf e vai pro
# AI_MODEL. Confira o catálogo da sua conta em /openai/v1/models.
# Cuidado ao trocar: o qwen3.6-27b tem teto de 1000 tokens de saída por
# minuto e rejeita esse prompt inteiro. Padrão do código se não
# definido: qwen/qwen3.8-27b
AI_VISION_MODEL="qwen/qwen3.8-27b"

# Telegram bot (src/app/api/telegram). Crie o bot com o @BotFather e
# registre o webhook uma vez:
#   curl -F "url=https://<host>/api/telegram" \
#        -F "secret_token=$TELEGRAM_WEBHOOK_SECRET" \
#        https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook
TELEGRAM_BOT_TOKEN="123456:ABC..."
# Segredo compartilhado que o Telegram devolve no header
# X-Telegram-Bot-Api-Secret-Token em toda entrega. Obrigatório: sem ele o
# webhook rejeita todas as atualizações, porque é a única coisa que
# protege uma rota pública que lê e grava dados financeiros.
# Gere com: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="troque-por-um-valor-aleatorio"
# Opcional — só o @nome do bot, sem o @. Usado apenas para o botão
# "Abrir o bot" na tela Mais → Telegram.
TELEGRAM_BOT_USERNAME="meu_fi_sync_bot"
