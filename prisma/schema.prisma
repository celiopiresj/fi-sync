// Prisma schema — see https://pris.ly/d/prisma-schema
// Connection/CLI config lives in `prisma.config.ts` at the project root
// (Prisma 7 moved `url` etc. out of the datasource block).
//
// Decisions (see tasks/001-data-model.md for context):
// - Multi-user: Account, Person, Category (user-created ones) and
//   Transaction all scope to a User.
// - Accounts: checking, savings, investment, pocket/"caixinha", credit
//   card, cash. No institution/bank modeling — tasks/007 originally
//   planned an optional Bank per account, but that was dropped before
//   shipping in favor of keeping accounts standalone.
// - Credit card accounts: a purchase is a normal Transaction (category,
//   person split, recurrence all reused as-is). Card-specific bits:
//   - CreditCardDetails (1:1, Account.type = CREDIT_CARD only): limit,
//     closingDay/dueDay — the *expected* day of month, used to suggest the
//     next Invoice. Not the source of truth for any specific period.
//   - Card (N:1 Account): a credit card account can have several physical
//     cards (titular + adicionais), each with its own name/last 4 digits.
//   - TransactionCard (1:1 join, not a column on Transaction): which
//     physical card a purchase was made on.
//   - Installments: installmentGroupId/Number/Count directly on
//     Transaction, same spirit as transferGroupId — one row per
//     installment, each holding that installment's own amount.
//   - Invoice: the actual closing/due date for one specific billing period
//     (can differ from CreditCardDetails' day-of-month default — banks
//     shift it for weekends/holidays), plus payment status.
//   - TransactionInvoice (1:1 join, not a column on Transaction): which
//     invoice a transaction landed in. Stored explicitly at creation time,
//     not recomputed later, since the closing date isn't always the same
//     day every month.
// - Categories: `Category.userId` null = system/seeded category shared by
//   everyone; set = created by that user.
// - People / balance split: a `Person` is a label the user defines (Eu,
//   Mãe, Irmão, Amigos...). A single Transaction's amount can be split
//   across multiple people via `TransactionSplit` (not just one person per
//   transaction).
// - Recurrence: `Recurrence` stores the rule (frequency, start, optional
//   end — null `endDate` = indefinite) plus a reusable content template:
//   description, amount, account (debit or CREDIT_CARD, same as
//   Transaction), optional category, optional card (CREDIT_CARD accounts
//   only), and person/splits (`RecurrenceSplit`, mirrors
//   `TransactionSplit` — every recurrence has at least one person,
//   optionally split across several). Generation (tasks/006, tasks/012)
//   creates actual Transaction rows in a rolling window — up to 12
//   months ahead at a time, all sharing `recurrenceId` — rather than
//   all-at-once, to avoid generating hundreds of rows for an indefinite
//   recurrence. There's still no background job: the app prompts to
//   extend the window once ~1 month of generated runway remains, and the
//   user can also decline (the recurrence just stays as-is, resumable
//   any time). A recurrence that reaches its `endDate` just stops
//   generating, nothing deletes it.
// - Transfers: modeled as two linked Transaction rows (one outgoing, one
//   incoming) sharing the same `transferGroupId` — not a separate type.
// - Money: `Decimal`, not integer cents — Prisma/Postgres NUMERIC gives
//   exact arithmetic without manual cents<->currency conversion.
// - Amount sign: positive = income, negative = expense. A transfer's two
//   legs are one negative (source account) and one positive (destination
//   account) row.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Identity (email, name, password/OAuth) lives in Neon Auth's own
// `neon_auth` schema, not here. `id` is NOT generated by us — it's set
// explicitly to match the Neon Auth user id when the row is created (see
// src/lib/auth/sync-user.ts). This model only exists so the rest of the
// schema has something to point `userId` at, and as a place for
// app-specific profile fields later (preferences, etc.) — not identity.
model User {
  id        String   @id
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  accounts     Account[]
  people       Person[]
  categories   Category[]
  transactions Transaction[]
  recurrences  Recurrence[]
  budgetGroups BudgetGroup[]
  budgets      Budget[]
  loans        Loan[]
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  POCKET // "caixinha"
  CREDIT_CARD
  CASH
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  type      AccountType
  currency  String        @default("BRL")
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  transactions      Transaction[]
  recurrences       Recurrence[]
  creditCardDetails CreditCardDetails?
  cards             Card[]
  invoices          Invoice[]

  @@index([userId])
}

// Only present when Account.type = CREDIT_CARD. Shared by every Card and
// Invoice under this account (the limit/statement is per account, not per
// physical card).
model CreditCardDetails {
  id        String  @id @default(cuid())
  accountId String  @unique
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  limit Decimal @db.Decimal(12, 2)
  // Expected day of month (1-31) — used to suggest the next Invoice. The
  // actual closing/due date for a given cycle lives on Invoice, since it
  // can shift (weekends, holidays).
  closingDay Int
  dueDay     Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

// A physical card under a CREDIT_CARD account — titular, adicionais. All
// cards on the same account share its limit and statement.
model Card {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name           String
  lastFourDigits String?
  colorStyle     String?
  // Reuses AccountStatus (same ACTIVE/INACTIVE shape) rather than a
  // separate CardStatus enum. A card can't be hard-deleted once it has
  // TransactionCard history (see tasks/013.md) — disabling it here is the
  // alternative: it drops out of the picker in transaction-form.tsx /
  // recurrence-form.tsx for NEW selections but stays intact, and visible,
  // on whatever transaction already used it.
  status         AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // A card can be used across many transactions — this is the many side.
  transactionCards TransactionCard[]
  // Recurrences that charge this specific card each time they generate.
  recurrences      Recurrence[]

  @@index([accountId])
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PARTIALLY_PAID
  PAID
}

// One specific billing period for a CREDIT_CARD account. Does not define
// the period boundaries by itself (that's tracked via TransactionInvoice
// per transaction) — it records the *actual* closing/due date and payment
// status for that cycle.
model Invoice {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  closingDate DateTime      @db.Date
  dueDate     DateTime      @db.Date
  // status/paidAmount/paidAt are a cached, denormalized view of `payments`
  // + `creditsReceived` — written only by recomputeInvoiceStatus
  // (src/lib/invoice-total.ts), the single place allowed to derive them,
  // never set ad hoc elsewhere. Kept as real columns (not computed at
  // every read) so list/filter queries don't need to join+aggregate
  // payments on every page load.
  status     InvoiceStatus @default(OPEN)
  paidAmount Decimal?      @db.Decimal(12, 2)
  paidAt     DateTime?     @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  transactionInvoices TransactionInvoice[]
  // One row per actual payment made against this invoice — an invoice can
  // now be paid off across several partial payments over time (see
  // InvoicePayment below), replacing the old single paymentTransactionId
  // FK this model used to carry.
  payments            InvoicePayment[]
  // Credit received from an EARLIER invoice's overpayment (see
  // InvoiceCredit below) — reduces this invoice's own amount due without
  // this invoice itself having any InvoicePayment of its own yet.
  creditsReceived      InvoiceCredit[]        @relation("CreditTarget")

  @@unique([accountId, closingDate])
  @@index([accountId])
}

// A single payment made against an Invoice — there can be several over
// time (partial payments accumulating toward the invoice's total), unlike
// the old model where an invoice had at most one settlement Transaction.
// Each payment is backed by its own real expense Transaction on the
// paying account (created by payInvoice, invoices/actions.ts).
model InvoicePayment {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // The expense Transaction this payment created on the paying account.
  // Cascade (not SetNull, unlike the old paymentTransactionId): deleting
  // the settlement Transaction means this specific payment never
  // happened, so the payment row — and any credit it generated (see
  // InvoiceCredit.sourcePayment) — must go with it. transactions/
  // actions.ts's revertPaidInvoicesFor recomputes the affected invoice(s)
  // status right after, in the same db transaction.
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  // Credit this payment's own overflow (paid beyond what this invoice
  // still owed) generated for a later invoice — see InvoiceCredit.
  creditsGiven InvoiceCredit[] @relation("CreditSourcePayment")

  @@index([invoiceId])
}

// Credit flowing from one invoice's overpayment into a later invoice's
// amount due — e.g. paying R$50 more than Invoice A's balance reduces
// Invoice B's (the next cycle) shown total by R$50 immediately, not only
// once B is itself paid. Modeled as its own row (not a plain accumulator
// scalar on Invoice) specifically so deleting the overpayment's own
// settlement Transaction can cascade-delete this credit too — reverting
// it precisely — and so a chain of credits (A funds B, B's own resulting
// overflow funds C) can be walked and unwound correctly. See
// recomputeInvoiceStatus (src/lib/invoice-total.ts) for how this is kept
// consistent.
model InvoiceCredit {
  id String @id @default(cuid())

  // Not @unique: a single overpayment can fund credit toward MORE than
  // one downstream invoice (e.g. paying R$300 over what's due when the
  // next invoice only totals R$200 so far — that invoice gets R$200 of
  // credit and the remaining R$100 rolls forward to the invoice after
  // it), so one InvoicePayment can be the source of several InvoiceCredit
  // rows. See payInvoice's overflow loop in invoices/actions.ts.
  sourcePaymentId String
  sourcePayment   InvoicePayment @relation("CreditSourcePayment", fields: [sourcePaymentId], references: [id], onDelete: Cascade)

  targetInvoiceId String
  targetInvoice   Invoice @relation("CreditTarget", fields: [targetInvoiceId], references: [id], onDelete: Cascade)

  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([sourcePaymentId])
  @@index([targetInvoiceId])
}

// A label the user defines to attribute (parts of) transactions to someone:
// "Eu", "Mãe", "Irmão", "Amigos"... Not a login-capable account.
model Person {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  phoneCountryCode String?
  phone            String?
  // Same AVAILABLE_COLORS palette (src/components/form/color-picker.tsx)
  // as Category/Card's own colorStyle — a light Tailwind bg/text pair
  // applied to this person's avatar/badge wherever they're shown.
  colorStyle       String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  // Marks which Person row represents the user themselves — at most one
  // true per userId, enforced in application code (setSelfPerson,
  // people/actions.ts), not a DB constraint, since Prisma's schema DSL
  // has no partial/conditional unique index. Nothing infers this from
  // `name === "Eu"` at runtime (a user can rename or never have such a
  // row) — only this flag counts. Used by the projections screen
  // (tasks/016) to sum only the user's own share of a split transaction
  // instead of its full amount.
  isSelf Boolean @default(false)

  splits           TransactionSplit[]
  recurrenceSplits RecurrenceSplit[]
  loans            Loan[]

  @@index([userId])
}

enum CategoryType {
  EXPENSE
  INCOME
  INVESTMENT
}

model Category {
  id        String   @id @default(cuid())
  // null = system-seeded category (shared by everyone); set = user-created
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      CategoryType @default(EXPENSE)
  colorStyle String?
  icon      String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  transactions Transaction[]
  recurrences  Recurrence[]
  budgetItems  BudgetItem[]

  @@index([userId])
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

// Fixed, global set (not user-customizable, same spirit as AccountType) —
// how the transaction was paid. Independent of Account: e.g. a PIX and a
// debit-card purchase can both land on the same checking account. Nullable
// — existing rows and anything the user doesn't bother setting stay
// unattributed, same as `categoryId`.
enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  PIX
  BOLETO
  OTHER
}

// Which kind of manual movement createInvestmentMovement
// (investments/actions.ts) created this Transaction for — set only on
// rows created through that flow (an INVESTMENT/POCKET account's
// aporte/rendimento/resgate); every other Transaction leaves this null.
// Persisted (not just the description text) specifically so a rendimento
// can be summed/filtered reliably — see investments/[id]'s
// getInvestmentAccountDetail.
enum InvestmentMovementKind {
  CONTRIBUTION
  YIELD
  WITHDRAWAL
}

model Transaction {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  description             String
  amount                  Decimal                 @db.Decimal(12, 2)
  date                    DateTime                @db.Date
  status                  TransactionStatus       @default(COMPLETED)
  paymentMethod           PaymentMethod?
  investmentMovementKind  InvestmentMovementKind?
  // Marks the one Transaction (if any) representing a CHECKING/SAVINGS/CASH
  // account's opening balance, set at creation or later via the account's
  // own edit form (accounts/actions.ts) — same "tag the Transaction rather
  // than add a stored balance column" approach investmentMovementKind uses
  // for investment accounts. At most one true row per accountId.
  isInitialBalance        Boolean                 @default(false)

  // Set on both legs of a transfer (outgoing + incoming); null otherwise.
  transferGroupId String?

  // Set on every installment of a card purchase split into N charges. Each
  // row holds that installment's own amount (12x of R$100 = 12 rows of
  // -100), not the full purchase amount.
  installmentGroupId String?
  installmentNumber  Int?
  installmentCount   Int?

  // Set when this transaction was generated from a recurrence rule (see
  // Recurrence below for how/when generation happens).
  recurrenceId String?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)

  // How this transaction's amount is split across people. If empty, the
  // full amount is unattributed (treat as 100% "Eu"/self at the app layer).
  splits TransactionSplit[]

  // Which physical card was used (credit card accounts only) and which
  // invoice/statement this landed in — both 1:1 join tables, not columns
  // here (see comments at the top of this file for why).
  transactionCard    TransactionCard?
  transactionInvoice TransactionInvoice?
  // The reverse of InvoicePayment.transaction — set only when this
  // Transaction *is* the settlement expense for one specific invoice
  // payment (as opposed to transactionInvoice above, set on the original
  // purchases that make up an invoice's total). At most one InvoicePayment
  // per settlement Transaction, enforced by InvoicePayment.transactionId's
  // own @unique.
  invoicePayment InvoicePayment?
  // The reverse of LoanInstallment.transaction — set only when this
  // Transaction *is* the settlement for one specific loan installment.
  loanInstallment LoanInstallment?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([transferGroupId])
  @@index([installmentGroupId])
  @@index([recurrenceId])
}

// Which physical Card a purchase was made on. Only relevant for
// CREDIT_CARD accounts with more than one Card; absent otherwise.
model TransactionCard {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  cardId        String
  card          Card        @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
}

// Which Invoice (billing period) a credit card transaction landed in.
// Assigned explicitly when the transaction is created — see the note on
// Invoice about why this isn't recomputed from a fixed day-of-month.
model TransactionInvoice {
  id            String      @id @default(cuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// One row per person a Transaction's amount is split across. The sum of
// `amount` across a transaction's splits should equal the transaction's
// `amount` — enforced at the application layer, not the DB.
model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  personId      String
  person        Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(12, 2)

  @@unique([transactionId, personId])
  @@index([transactionId])
  @@index([personId])
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// Stores the recurrence rule (frequency, start, optional end) plus a
// reusable content template — description, amount, account, optional
// category/card, and person/splits — used each time new Transaction rows
// are generated for it. See the top-of-file Decisions note for the full
// generation model (tasks/006, extended by tasks/012).
model Recurrence {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // Which physical card each generated charge should use — CREDIT_CARD
  // accounts only. A direct column here (unlike Transaction, which joins
  // through TransactionCard) since the recurrence only needs one template
  // value, not a per-row join. The invoice itself is NOT part of the
  // template — it's resolved fresh per occurrence at generation time
  // (resolveInvoiceForDate), since the same recurrence's occurrences land
  // in different billing cycles.
  cardId     String?
  card       Card?               @relation(fields: [cardId], references: [id], onDelete: SetNull)
  // How each generated occurrence was paid — same fixed enum as
  // Transaction.paymentMethod, copied onto every generated Transaction row
  // at generation time (see createRecurrenceOccurrence in actions.ts).
  paymentMethod PaymentMethod?

  description String
  amount      Decimal             @db.Decimal(12, 2)
  frequency   RecurrenceFrequency
  startDate   DateTime            @db.Date
  // Null = no end date (recurs indefinitely).
  endDate     DateTime?           @db.Date

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  transactions Transaction[]
  // Person/split template applied to every generated occurrence — see
  // RecurrenceSplit. Every recurrence has at least one split (the "who
  // paid" person), optionally more if it's shared.
  splits       RecurrenceSplit[]

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([cardId])
}

// One row per person a Recurrence's amount is split across — copied onto
// each generated Transaction's own TransactionSplit rows at generation
// time. Mirrors TransactionSplit field-for-field. The sum of `amount`
// across a recurrence's splits should equal the recurrence's `amount`,
// same rule as TransactionSplit, enforced at the application layer.
model RecurrenceSplit {
  id           String     @id @default(cuid())
  recurrenceId String
  recurrence   Recurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  personId     String
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  amount       Decimal    @db.Decimal(12, 2)

  @@unique([recurrenceId, personId])
  @@index([recurrenceId])
  @@index([personId])
}

// -----------------------------------------------------------------------
// Budget: monthly spending plan per user, organized into groups of
// category-level limits. BudgetGroup is purely organizational (label +
// sort order, no limit of its own) — the group's total is the sum of its
// items' limits, shown in the UI for context. Budget is the monthly
// container (expected income + items). BudgetItem is one category's
// spending limit within that month's budget, optionally assigned to a
// group. See tasks/implementation_plan.md for the full screen spec.
// -----------------------------------------------------------------------

// User-defined group to visually organize categories in the budget
// screen (e.g. "Essenciais", "Lazer", "Investimentos"). Has no limit of
// its own — just a label, sort order, and a bag of BudgetItems.
model BudgetGroup {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  budgetItems BudgetItem[]

  @@index([userId])
}

// One month's budget for a user. `month` stores the first day of the
// calendar month (e.g. 2026-08-01) as a Date, same @db.Date convention
// as Transaction.date / Invoice.closingDate elsewhere in this schema.
// `expectedIncome` is informational (the user's target income for this
// month) — category limits are independent and don't need to sum to it.
model Budget {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  month          DateTime @db.Date
  expectedIncome Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  items BudgetItem[]

  @@unique([userId, month])
  @@index([userId])
}

// One category's spending limit within a monthly Budget. Optionally
// belongs to a BudgetGroup for visual organization. The actual spending
// is computed at query time from Transaction rows, not stored here.
model BudgetItem {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  groupId String?
  group   BudgetGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  limit     Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  @@unique([budgetId, categoryId])
  @@index([budgetId])
  @@index([categoryId])
  @@index([groupId])
}

// -----------------------------------------------------------------------
// Loans (tasks/017): a personal loan the user is paying off in fixed
// installments — always tied to a Person, always settled as a plain
// expense (no LENT/receivable side; a loan the user made TO someone
// isn't tracked here). Same installmentNumber/Count-per-row shape as a
// credit card purchase, not an arbitrary-amount-against-a-total shape
// like Invoice. Interest is out of scope for v1. The loan's initial
// disbursement is optionally recorded as a one-time income Transaction
// at creation (see createLoan's receivedAmount/receivedAccountId) —
// not stored on Loan itself, since the Transaction it creates is
// already the durable record of it.
// -----------------------------------------------------------------------

model Loan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Same Cascade-at-the-DB-level-but-app-blocks-first convention as
  // TransactionSplit.personId — deletePerson (people/actions.ts) checks
  // for real history before allowing a delete, this is just the safety
  // net.
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  description String
  // The first installment's due date — every following installment is
  // one month later, clamped to whatever that month actually has (see
  // computeLoanInstallmentDates/setDateClamped in actions.ts). No
  // separate "start date" — unlike a credit card cycle, a loan payment
  // has no closing/due split to anchor against.
  dueDate     DateTime @db.Date
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  installments LoanInstallment[]

  @@index([userId])
  @@index([personId])
}

// One expected payment in a Loan's schedule. Paid/pending is derived
// from whether transactionId is set, not a separate stored status field
// — nothing to keep in sync when that Transaction is deleted, since
// transactionId's own onDelete: SetNull already reverts this row to
// "pending" for free at that point.
model LoanInstallment {
  id     String @id @default(cuid())
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  installmentNumber Int
  installmentCount  Int
  dueDate           DateTime @db.Date
  amount            Decimal  @db.Decimal(12, 2)

  // The real Transaction created when this installment was marked
  // paid — null until then. SetNull (not Cascade, unlike
  // InvoicePayment.transactionId): deleting the settlement Transaction
  // from /transactions should un-pay this installment, not delete the
  // installment itself — the schedule slot is still real, just unpaid
  // again.
  transactionId String?      @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([loanId, installmentNumber])
  @@index([loanId])
}
